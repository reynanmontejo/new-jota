# Browser-safe Supabase connection values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Google Drive OAuth. Create a Web application OAuth client and
# register the exact redirect URI listed in docs/google-drive-setup.md.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_OWNER_EMAIL=joynojohn@gmail.com
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/google-drive/callback
# Generate with: openssl rand -base64 32
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=

# Optional server-only web push for task notifications. Generate VAPID keys
# with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
# Set this on the app host and configure its scheduler to POST
# /api/notifications/dispatch with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
